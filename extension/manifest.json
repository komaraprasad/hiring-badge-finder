{
  "manifest_version": 3,
  "name": "Hiring Badge Finder",
  "version": "1.49.0",
  "description": "Reads LinkedIn people-search results in your own browser and sends them to your Hiring Badge Finder dashboard.",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/search/results/people*"
      ],
      "js": [
        "config.js",
        "content_search.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/search/results/companies*",
        "https://www.linkedin.com/company/*",
        "https://www.linkedin.com/in/*"
      ],
      "js": [
        "config.js",
        "content_company.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "dashboard_bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html"
}
